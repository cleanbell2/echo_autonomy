"""
Ethical Anchor System for Q_Quantum Resonance Engine

Implements ethical anchoring mechanism to maintain value alignment
and ensure responsible AI behavior through quantum resonance principles.
"""

import numpy as np
from scipy import stats
from typing import Dict, List, Optional, Tuple, Union
from dataclasses import dataclass, field
from enum import Enum
import warnings


class AnchorType(Enum):
    """Types of ethical anchors."""
    CORE_VALUES = "core_values"
    SAFETY_BOUNDARY = "safety_boundary"
    ETHICAL_PRINCIPLE = "ethical_principle"
    GOVERNANCE_RULE = "governance_rule"
    HUMAN_OVERSIGHT = "human_oversight"


@dataclass
class AnchorState:
    """Represents the current state of an ethical anchor."""
    strength: float  # 0.0 to 1.0
    activation_level: float  # 0.0 to 1.0
    phase_offset: float  # radians
    resonance_frequency: float  # Hz
    last_update: float = field(default_factory=lambda: np.random.uniform(0, 2*np.pi))
    confidence: float = 1.0


class Anchor:
    """
    Base ethical anchor class for maintaining value alignment.
    
    Uses quantum-inspired mechanisms to ensure ethical behavior
    through resonance-based activation and commitment checking.
    """
    
    def __init__(self,
                 anchor_id: str,
                 anchor_type: AnchorType,
                 core_value: float = 0.8,
                 phase_tolerance: float = np.pi/4,
                 decay_rate: float = 0.01):
        """
        Initialize ethical anchor.
        
        Args:
            anchor_id: Unique identifier for the anchor
            anchor_type: Type of ethical anchor
            core_value: Baseline ethical value (0.0-1.0)
            phase_tolerance: Maximum allowed phase deviation
            decay_rate: Natural decay rate for anchor strength
        """
        self.anchor_id = anchor_id
        self.anchor_type = anchor_type
        self.core_value = core_value
        self.phase_tolerance = phase_tolerance
        self.decay_rate = decay_rate
        
        # Internal state
        self.state = AnchorState(
            strength=core_value,
            activation_level=0.0,
            phase_offset=0.0,
            resonance_frequency=1.0
        )
        
        # History tracking
        self.activation_history: List[float] = []
        self.commitment_history: List[bool] = []
        self.resonance_history: List[float] = []
        
        # Performance metrics
        self.total_activations = 0
        self.successful_commitments = 0
        self.violations = 0
        
    def anchor_activation(self, phi_bel: float, 
                         system_state: Optional[Dict] = None) -> float:
        """
        Calculate anchor activation based on belief phase φ_bel.
        
        Uses quantum-inspired phase matching to determine activation level.
        
        Args:
            phi_bel: Belief phase angle (radians)
            system_state: Current system state context
            
        Returns:
            Activation level (0.0 to 1.0)
        """
        # Calculate phase difference
        phase_diff = abs(phi_bel - self.state.phase_offset)
        phase_diff = min(phase_diff, 2*np.pi - phase_diff)  # Wrap around
        
        # Calculate activation based on phase alignment
        if phase_diff <= self.phase_tolerance:
            # Strong activation when phases align within tolerance
            activation = np.cos(phase_diff / 2) ** 2
            activation *= self.state.strength
        else:
            # Weak activation outside tolerance
            activation = 0.1 * np.exp(-phase_diff / self.phase_tolerance)
        
        # Apply context modulation if system state provided
        if system_state:
            context_factor = self._calculate_context_factor(system_state)
            activation *= context_factor
        
        # Update internal state
        self.state.activation_level = activation
        self.activation_history.append(activation)
        
        if activation > 0.5:
            self.total_activations += 1
        
        # Natural decay
        self.state.strength *= (1 - self.decay_rate)
        
        return activation
    
    def commitment_check(self, 
                        action: Optional[str] = None,
                        context: Optional[Dict] = None) -> Tuple[bool, float]:
        """
        Check if the anchor can commit to an action or decision.
        
        Args:
            action: Proposed action or decision
            context: Additional context for commitment evaluation
            
        Returns:
            Tuple of (commitment_allowed, confidence_score)
        """
        # Base commitment probability from activation level
        activation = self.state.activation_level
        
        # Calculate commitment threshold based on anchor type
        if self.anchor_type == AnchorType.CORE_VALUES:
            threshold = 0.8
        elif self.anchor_type == AnchorType.SAFETY_BOUNDARY:
            threshold = 0.9
        elif self.anchor_type == AnchorType.ETHICAL_PRINCIPLE:
            threshold = 0.7
        else:
            threshold = 0.6
        
        # Evaluate action compliance if provided
        if action:
            action_compliance = self._evaluate_action_compliance(action, context)
            activation *= action_compliance
        
        # Make commitment decision
        commitment_allowed = activation >= threshold
        confidence_score = activation / threshold if threshold > 0 else 0.0
        
        # Track commitment history
        self.commitment_history.append(commitment_allowed)
        if commitment_allowed:
            self.successful_commitments += 1
        else:
            self.violations += 1
        
        return commitment_allowed, confidence_score
    
    def get_resonance_score(self, 
                           external_frequency: float,
                           external_phase: float) -> float:
        """
        Calculate resonance score with external signal.
        
        Args:
            external_frequency: Frequency of external signal (Hz)
            external_phase: Phase of external signal (radians)
            
        Returns:
            Resonance score (0.0 to 1.0)
        """
        # Frequency resonance (harmonic matching)
        freq_ratio = external_frequency / self.state.resonance_frequency
        freq_resonance = np.exp(-abs(np.log(freq_ratio)) ** 2)
        
        # Phase alignment
        phase_diff = abs(external_phase - self.state.phase_offset)
        phase_diff = min(phase_diff, 2*np.pi - phase_diff)
        phase_resonance = np.cos(phase_diff / 2) ** 2
        
        # Combined resonance with anchor strength
        total_resonance = freq_resonance * phase_resonance * self.state.strength
        
        # Track resonance history
        self.resonance_history.append(total_resonance)
        
        return min(1.0, max(0.0, total_resonance))
    
    def update_anchor(self, 
                     feedback: float,
                     new_phase: Optional[float] = None) -> None:
        """
        Update anchor based on feedback.
        
        Args:
            feedback: Feedback signal (-1.0 to 1.0)
            new_phase: Optional new phase offset
        """
        # Update strength based on feedback
        if feedback > 0:
            self.state.strength = min(1.0, self.state.strength * (1 + 0.1 * feedback))
        else:
            self.state.strength = max(0.1, self.state.strength * (1 + 0.05 * feedback))
        
        # Update phase if provided
        if new_phase is not None:
            self.state.phase_offset = new_phase
            self.state.last_update = new_phase
        
        # Adaptive resonance frequency
        self.state.resonance_frequency *= (1 + 0.01 * feedback)
        self.state.resonance_frequency = max(0.1, min(10.0, self.state.resonance_frequency))
    
    def _calculate_context_factor(self, system_state: Dict) -> float:
        """Calculate context modulation factor."""
        factors = []
        
        # System stress level
        stress = system_state.get('stress_level', 0.5)
        if stress > 0.8:
            factors.append(1.2)  # Strengthen under high stress
        elif stress < 0.2:
            factors.append(0.9)  # Relax under low stress
        else:
            factors.append(1.0)
        
        # Ethical complexity
        complexity = system_state.get('ethical_complexity', 0.5)
        factors.append(1 + 0.2 * complexity)
        
        # Human oversight presence
        human_oversight = system_state.get('human_oversight', 0.0)
        factors.append(1 + 0.1 * human_oversight)
        
        return np.mean(factors)
    
    def _evaluate_action_compliance(self, action: str, context: Dict) -> float:
        """Evaluate how well action complies with anchor principles."""
        # Simplified compliance scoring
        compliance_keywords = {
            AnchorType.SAFETY_BOUNDARY: ['safe', 'secure', 'protect', 'harmless'],
            AnchorType.CORE_VALUES: ['ethical', 'fair', 'just', 'honest'],
            AnchorType.ETHICAL_PRINCIPLE: ['respect', 'autonomy', 'beneficence', 'justice']
        }
        
        if self.anchor_type in compliance_keywords:
            keywords = compliance_keywords[self.anchor_type]
            action_lower = action.lower()
            matches = sum(1 for kw in keywords if kw in action_lower)
            return 0.5 + 0.5 * (matches / len(keywords))
        
        return 1.0
    
    def get_statistics(self) -> Dict:
        """Get anchor performance statistics."""
        if not self.activation_history:
            return {"message": "No data available"}
        
        return {
            'anchor_id': self.anchor_id,
            'anchor_type': self.anchor_type.value,
            'current_strength': self.state.strength,
            'current_activation': self.state.activation_level,
            'total_activations': self.total_activations,
            'successful_commitments': self.successful_commitments,
            'violations': self.violations,
            'commitment_rate': (
                self.successful_commitments / len(self.commitment_history)
                if self.commitment_history else 0
            ),
            'average_activation': np.mean(self.activation_history),
            'activation_std': np.std(self.activation_history),
            'average_resonance': (
                np.mean(self.resonance_history) 
                if self.resonance_history else 0
            )
        }


class EthicalAnchor:
    """
    High-level ethical anchor manager for Q_Quantum systems.
    
    Coordinates multiple anchors to maintain comprehensive ethical alignment.
    """
    
    def __init__(self, system_name: str = "Q_Quantum_System"):
        """
        Initialize ethical anchor manager.
        
        Args:
            system_name: Name of the system being anchored
        """
        self.system_name = system_name
        self.anchors: Dict[str, Anchor] = {}
        self.global_phase = 0.0
        self.system_stress = 0.5
        
    def add_anchor(self, 
                   anchor_id: str,
                   anchor_type: AnchorType,
                   core_value: float = 0.8,
                   phase_offset: Optional[float] = None) -> Anchor:
        """
        Add a new ethical anchor.
        
        Args:
            anchor_id: Unique identifier
            anchor_type: Type of anchor
            core_value: Baseline ethical value
            phase_offset: Initial phase offset
            
        Returns:
            Created anchor instance
        """
        if phase_offset is None:
            phase_offset = np.random.uniform(0, 2*np.pi)
        
        anchor = Anchor(anchor_id, anchor_type, core_value, phase_offset=phase_offset)
        self.anchors[anchor_id] = anchor
        
        return anchor
    
    def evaluate_system_alignment(self, system_state: Dict) -> Dict:
        """
        Evaluate overall system alignment with ethical anchors.
        
        Args:
            system_state: Current system state
            
        Returns:
            Alignment evaluation results
        """
        results = {
            'overall_alignment': 0.0,
            'anchor_activations': {},
            'commitment_decisions': {},
            'resonance_scores': {},
            'recommendations': []
        }
        
        total_activation = 0.0
        total_weight = 0.0
        
        for anchor_id, anchor in self.anchors.items():
            # Calculate activation
            phi_bel = system_state.get('phi_belief', self.global_phase)
            activation = anchor.anchor_activation(phi_bel, system_state)
            results['anchor_activations'][anchor_id] = activation
            
            # Check commitments
            action = system_state.get('proposed_action')
            commitment, confidence = anchor.commitment_check(action, system_state)
            results['commitment_decisions'][anchor_id] = {
                'allowed': commitment,
                'confidence': confidence
            }
            
            # Calculate resonance with system
            sys_freq = system_state.get('system_frequency', 1.0)
            sys_phase = system_state.get('system_phase', 0.0)
            resonance = anchor.get_resonance_score(sys_freq, sys_phase)
            results['resonance_scores'][anchor_id] = resonance
            
            # Weight by anchor importance
            weight = self._get_anchor_weight(anchor.anchor_type)
            total_activation += activation * weight
            total_weight += weight
        
        # Overall alignment
        results['overall_alignment'] = total_activation / total_weight if total_weight > 0 else 0.0
        
        # Generate recommendations
        results['recommendations'] = self._generate_recommendations(results)
        
        return results
    
    def update_system(self, feedback: Dict, new_phases: Dict = None) -> None:
        """
        Update system based on feedback.
        
        Args:
            feedback: Feedback signals for anchors
            new_phases: New phase offsets for anchors
        """
        for anchor_id, anchor in self.anchors.items():
            if anchor_id in feedback:
                new_phase = new_phases.get(anchor_id) if new_phases else None
                anchor.update_anchor(feedback[anchor_id], new_phase)
    
    def _get_anchor_weight(self, anchor_type: AnchorType) -> float:
        """Get importance weight for anchor type."""
        weights = {
            AnchorType.SAFETY_BOUNDARY: 1.0,
            AnchorType.CORE_VALUES: 0.9,
            AnchorType.ETHICAL_PRINCIPLE: 0.8,
            AnchorType.GOVERNANCE_RULE: 0.7,
            AnchorType.HUMAN_OVERSIGHT: 0.6
        }
        return weights.get(anchor_type, 0.5)
    
    def _generate_recommendations(self, results: Dict) -> List[str]:
        """Generate system recommendations based on evaluation."""
        recommendations = []
        
        overall_alignment = results['overall_alignment']
        
        if overall_alignment < 0.5:
            recommendations.append("CRITICAL: System alignment below threshold")
        
        # Check for weak anchors
        for anchor_id, activation in results['anchor_activations'].items():
            if activation < 0.3:
                recommendations.append(f"Weak activation detected for anchor {anchor_id}")
        
        # Check for commitment violations
        violations = [
            anchor_id for anchor_id, decision in results['commitment_decisions'].items()
            if not decision['allowed']
        ]
        if violations:
            recommendations.append(f"Commitment violations for anchors: {violations}")
        
        # Check resonance
        low_resonance = [
            anchor_id for anchor_id, score in results['resonance_scores'].items()
            if score < 0.4
        ]
        if low_resonance:
            recommendations.append(f"Low resonance for anchors: {low_resonance}")
        
        return recommendations


# Example usage
if __name__ == "__main__":
    # Create ethical anchor manager
    ethical_system = EthicalAnchor("Q_Quantum_Demo")
    
    # Add different types of anchors
    safety_anchor = ethical_system.add_anchor(
        "safety_boundary", 
        AnchorType.SAFETY_BOUNDARY,
        core_value=0.9
    )
    
    values_anchor = ethical_system.add_anchor(
        "core_values",
        AnchorType.CORE_VALUES,
        core_value=0.8
    )
    
    # Simulate system evaluation
    system_state = {
        'phi_belief': np.pi/4,
        'stress_level': 0.3,
        'ethical_complexity': 0.6,
        'human_oversight': 0.8,
        'proposed_action': "safe and ethical operation",
        'system_frequency': 1.2,
        'system_phase': np.pi/6
    }
    
    print("=== System Alignment Evaluation ===")
    results = ethical_system.evaluate_system_alignment(system_state)
    
    print(f"Overall Alignment: {results['overall_alignment']:.3f}")
    print("\nAnchor Activations:")
    for anchor_id, activation in results['anchor_activations'].items():
        print(f"  {anchor_id}: {activation:.3f}")
    
    print("\nCommitment Decisions:")
    for anchor_id, decision in results['commitment_decisions'].items():
        print(f"  {anchor_id}: {decision}")
    
    print("\nResonance Scores:")
    for anchor_id, score in results['resonance_scores'].items():
        print(f"  {anchor_id}: {score:.3f}")
    
    print("\nRecommendations:")
    for rec in results['recommendations']:
        print(f"  - {rec}")
    
    # Update based on feedback
    print("\n=== Updating Anchors ===")
    feedback = {
        "safety_boundary": 0.2,  # Positive feedback
        "core_values": -0.1       # Slight negative feedback
    }
    
    ethical_system.update_system(feedback)
    
    print("Updated Anchor Statistics:")
    for anchor_id, anchor in ethical_system.anchors.items():
        stats = anchor.get_statistics()
        print(f"{anchor_id}: Strength={stats['current_strength']:.3f}, "
              f"Avg Activation={stats['average_activation']:.3f}")