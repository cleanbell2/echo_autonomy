# Echo Gateway Environment Configuration (Phase 7)
# WARNING: Never commit this file to Git!

# ==========================================
# LLM Provider Configuration
# ==========================================

# Provider Selection: fake | openai | anthropic
LLM_PROVIDER=fake
# LLM_PROVIDER=openai
# LLM_PROVIDER=anthropic

# ==========================================
# API Keys (required for real providers)
# ==========================================

# OpenAI API Key (starts with sk-proj- or sk-)
# LLM_API_KEY=sk-proj-...

# Anthropic API Key (starts with sk-ant-)
# LLM_API_KEY=sk-ant-api03-...

# ==========================================
# Model Configuration
# ==========================================

# OpenAI Models
LLM_MODEL=gpt-4-turbo-preview
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL=gpt-3.5-turbo

# Anthropic Models (Claude)
# LLM_MODEL=claude-3-5-sonnet-20240620  # Sonnet 4.5 (벨의 선택)
# LLM_MODEL=claude-3-opus-20240229      # Opus (highest capability)
# LLM_MODEL=claude-3-haiku-20240307     # Haiku (fastest)

# ==========================================
# Request Parameters
# ==========================================

LLM_TEMPERATURE=0.7        # Sampling temperature (0.0 - 2.0)
LLM_MAX_TOKENS=1024        # Max tokens per request (OpenAI: 4096, Anthropic: 4096)
LLM_TIMEOUT_S=30           # Request timeout in seconds

# Base URL (optional, for proxy or custom endpoints)
# LLM_BASE_URL=https://api.openai.com

# ==========================================
# Quick Start Examples
# ==========================================

# Development (no API key needed)
# LLM_PROVIDER=fake

# OpenAI GPT-4
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-proj-your-key-here
# LLM_MODEL=gpt-4-turbo-preview

# Anthropic Claude Sonnet 4.5 (recommended)
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-api03-your-key-here
# LLM_MODEL=claude-3-5-sonnet-20240620
# LLM_MAX_TOKENS=4096
